#!/bin/sh /etc/rc.common
# Prepara le cartelle dati (anche su disco USB montato) e il link ai file condivisi

START=99

start() {
	local p
	p=$(uci -q get piratebox.main.path)
	[ -n "$p" ] || return 0
	mkdir -p "$p/files" "$p/forum"
	rm -f "$p"/files/.up-*
	ln -sfn "$p/files" /www/piratebox/files

	if [ "$(uci -q get piratebox.main.nginx_moved)" = 1 ]; then
		( /usr/sbin/piratebox-setup --ports ) >/dev/null 2>&1 &
	fi

	# MediaTek (mtk) driver leaves the extra AP interface down after boot
	local pbif
	pbif=$(uci -q show wireless | sed -n "s/^wireless\.pb_[A-Za-z0-9_]*\.ifname='\(.*\)'$/\1/p")
	if [ -n "$pbif" ]; then
		( i=0; while [ $i -lt 12 ]; do
			for n in $pbif; do ifconfig "$n" up; done
			i=$((i + 1)); sleep 5
		done ) >/dev/null 2>&1 &
	fi
}
